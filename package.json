{
  "name": "andrei-parcheuski-portfolio",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format:test": "prettier --list-different \"./src/**/*.{ts,html,css,scss,json}\" \"./scripts/**/*.mjs\" \"./*.{json,md}\"",
    "format:write": "prettier --write \"./src/**/*.{ts,html,css,scss,json}\" \"./scripts/**/*.mjs\" \"./*.{json,md}\"",
    "shots": "ng build && node scripts/shots.mjs",
    "shots:only": "node scripts/shots.mjs"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@angular/common": "^22.0.5",
    "@angular/compiler": "^22.0.5",
    "@angular/core": "^22.0.5",
    "@angular/forms": "^22.0.5",
    "@angular/platform-browser": "^22.0.5",
    "@angular/platform-server": "^22.0.5",
    "@angular/router": "^22.0.5",
    "@angular/ssr": "^22.0.5",
    "@vercel/analytics": "^2.0.1",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.5",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.19",
    "@types/three": "^0.186.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "description": "Personal portfolio — Senior Angular Developer (3D / WebGL)"
}
